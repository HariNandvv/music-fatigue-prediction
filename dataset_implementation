# Personalized Music Fatigue Detection
# Basic implementation using List, Tuple, Set and Dictionary


# LIST
# Stores the songs in the order the user listened to them

listening_history = [
    "Blinding Lights",
    "Shape of You",
    "Blinding Lights",
    "Believer",
    "Blinding Lights",
    "Shape of You",
    "Blinding Lights",
    "Blinding Lights"
]

print("Listening History:")
print(listening_history)


# TUPLE
# Stores fixed information about a listening event
# (Song, Time)

listening_event = ("Blinding Lights", "10:30 PM")

print("\nListening Event:")
print("Song:", listening_event[0])
print("Time:", listening_event[1])


# SET
# Stores only unique songs

unique_songs = set(listening_history)

print("\nUnique Songs:")
print(unique_songs)


# DICTIONARY
# Stores each song and the number of times it was played

song_count = {}

for song in listening_history:
    if song in song_count:
        song_count[song] += 1
    else:
        song_count[song] = 1

print("\nSong Play Count:")
print(song_count)


# FIND THE MOST REPEATED SONG

most_repeated_song = max(song_count, key=song_count.get)

print("\nMost Repeated Song:")
print(most_repeated_song)

print("Number of plays:", song_count[most_repeated_song])


# SIMPLE FATIGUE INDICATOR

if song_count[most_repeated_song] >= 5:
    print("Fatigue Level: HIGH")
elif song_count[most_repeated_song] >= 3:
    print("Fatigue Level: MEDIUM")
else:
    print("Fatigue Level: LOW")
